# HELP exportarr_app_info A metric with a constant '1' value labeled by app name, version, build time, and revision.
# TYPE exportarr_app_info gauge
exportarr_app_info{app_name="exportarr",build_time="",revision="",version="development"} 1
# HELP promhttp_metric_handler_errors_total Total number of internal errors encountered by the promhttp metric handler.
# TYPE promhttp_metric_handler_errors_total counter
promhttp_metric_handler_errors_total{cause="encoding"} 0
promhttp_metric_handler_errors_total{cause="gathering"} 0
# HELP prowlarr_collector_error Error while collecting metrics
# TYPE prowlarr_collector_error gauge
prowlarr_collector_error{url="http://fixture"} 1
# HELP prowlarr_history_total Total number of item in the history
# TYPE prowlarr_history_total gauge
prowlarr_history_total{url="http://fixture"} 1368
# HELP prowlarr_indexer_unavailable Indexers marked unavailable due to repeated errors
# TYPE prowlarr_indexer_unavailable gauge
prowlarr_indexer_unavailable{indexer="SomeIndexer",url="http://fixture"} 1
# HELP prowlarr_scrape_duration_seconds Distribution of scrape durations.
# TYPE prowlarr_scrape_duration_seconds histogram
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="0.1"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="0.25"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="0.5"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="1"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="2.5"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="5"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="10"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="30"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="60"} X
prowlarr_scrape_duration_seconds_bucket{url="http://fixture",le="+Inf"} X
prowlarr_scrape_duration_seconds_sum{url="http://fixture"} X
prowlarr_scrape_duration_seconds_count{url="http://fixture"} X
# HELP prowlarr_scrape_requests_total Total number of HTTP requests made.
# TYPE prowlarr_scrape_requests_total counter
prowlarr_scrape_requests_total{code="200",url="http://fixture"} 1
# HELP prowlarr_system_health_issues Total number of health issues by source, type, message and wikiurl
# TYPE prowlarr_system_health_issues gauge
prowlarr_system_health_issues{message="Indexers unavailable due to failures for more than 6 hours: SomeIndexer",source="IndexerLongTermStatusCheck",type="warning",url="http://fixture",wikiurl="https://wiki.servarr.com/sonarr/system#indexers-are-unavailable-due-to-failures"} 1
# HELP prowlarr_system_status System Status
# TYPE prowlarr_system_status gauge
prowlarr_system_status{url="http://fixture"} 1
